    "connectorAttributes": {
      "SQL": "SELECT \n    U.LOGIN, \n    U.USER_ID, \n    U.LAST_NAME, \n    U.FIRST_NAME, \n    U.EMAIL, \n    U.PHONE_NUMBER, \n    U.ADDRESS, \n    U.COMMENT, \n    U.LOCKED, \n    U.ACTIVATED, \n    U.MONOSIGN, \n    U.PASSWORD_REQUIRED, \n    U.ROBOTIC, \n    U.FROZEN, \n    U.LAST_SIGN_IN_DATE, \n    U.CREATION_DATE, \n    U.ACTIVATION_DATE, \n    U.EXPIRATION_DATE, \n    \n    -- 1. Cleaned and Truncated List: ZRHLX0201,ZRHLX0202\n    REGEXP_REPLACE(\n        REPLACE(\n            REGEXP_REPLACE(U.LOGIN_AREAS, '\\(default\\)', ''), \n            ', ', ','\n        ), \n        '/[^,]*', \n        ''\n    ) AS LOGIN_AREAS,\n\n    U.\"CREDIT CARD DISPLAY\", \n    U.\"PROFILE CREDIT CARD\", \n    U.\"REMOTE OFFICE\", \n    U.\"TICKETING IN REMOTE OFFICE\", \n    U.\"SECURITY MATRIX NAME\", \n    U.\"DISPLAY NON-IATA LOCATIONS\",\n\n    -- 2. Derived Primary Area: ZRHLX0201\n    REGEXP_REPLACE(\n        CASE \n            WHEN LOCATE('/', U.LOGIN_AREAS) > 0 \n            THEN SUBSTRING(U.LOGIN_AREAS, 1, LOCATE('/', U.LOGIN_AREAS) - 1)\n            ELSE U.LOGIN_AREAS \n        END, \n        '\\(default\\)', ''\n    ) AS PRIMARY_LOGIN_AREA,\n\n    -- 3. Joined Role Field (Null if no match found)\n    R.ROLE_LABEL AS ROLES\n\nFROM Users U\nLEFT OUTER JOIN Roles R ON U.USER_ID = R.CONSUMER_ID\nORDER BY U.USER_ID",
      "additionalConnProperties": [
        "_CSV_Comment=1",
        "_CSV_Header=true",
        "_CSV_Separator=|"
      ],
