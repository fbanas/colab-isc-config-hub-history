    },
    "trigger": {
      "attributes": {
        "id": "idn:access-request-trigger",
        "integrationId": null
      },
      "type": "AccessRequestTrigger"
    }
  },
  "self": {
    "id": "3297f78b-b085-43b5-a278-eecfb22d7b64",
    "name": "SOD Violation Check - Multi-Step Serial Approval of Access Request",
