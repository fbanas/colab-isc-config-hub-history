            "reviewerIdentitiesToCertify.$": "$.getIdentity.id",
            "type": "REVIEWER_IDENTITY",
            "undecidedAccess": false
          },
          "description": null,
          "nextStep": "Send Email",
          "type": "action",
          "versionNumber": 2
        },
        "End Step — Success": {
          "actionId": "sp:operator-success",
          "type": "success"
        },
        "Get Identity": {
          "actionId": "sp:get-identity",
          "attributes": {
            "id.$": "$.trigger.identity.id"
          },
          "nextStep": "Create Certification Campaign",
          "type": "action",
          "versionNumber": 2
        },
